generator client {
    provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Define models here
model User {
    id        String  @id @default(uuid()) // Primary key with UUID generation for security 
    email     String  @unique
    phone     String? @unique
    firstname String
    lastname  String
    password  String
	role   String @default("CUSTOMER") // Default role set to CUSTOMER
    status    String  @default("ACTIVE") // Default status set to ACTIVE Banned suspended
    CreatedAt DateTime @default(now())
    UpdatedAt DateTime @updatedAt
    lastLogin DateTime? // Optional field for tracking last login time
    privileges Json? @default("[]") // Optional field for storing user privileges

}
