generator client {
    provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Define models here
model User {
    id        String  @id @default(uuid()) // Primary key with UUID generation for security 
    email     String  @unique
    phone     String? @unique
    firstname String
    lastname  String
    password  String
	role   String @default("CUSTOMER") // Default role set to CUSTOMER
    status    String  @default("ACTIVE") // Default status set to ACTIVE Banned suspended
    CreatedAt DateTime @default(now())
    UpdatedAt DateTime @updatedAt
    lastLogin DateTime? // Optional field for tracking last login time
    privileges Json? @default("[]") // Optional field for storing user privileges
    profileImage String @default("/images/default-profile.png")

}

enum ProductStatus { // Enum for product status
  ACTIVE
  INACTIVE
  DELETED
}

model Product{
  id String @id @default(uuid())
  sku String @unique
  name String
  altNames String[] @default([])
  description String
  stock Int @default(0)
  // status String @default("ACTIVE") // ACTIVE, INACTIVE, DISCONTINUED
  status ProductStatus @default(ACTIVE)
  price Float
  compareAt Float?
  brand String?
  model String?
  media Media[] // product have multiple media
}

enum MediaType { // Enum for media type
  IMAGE
  VIDEO
}

model Media{
  id String @id @default(uuid())
  url String 
  type MediaType
  productId String
  product Product @relation(fields : [productId], references: [id])
}